# Copy to .env and fill in what you need. Nothing here is required:
# the tool reads the session from a running browser by default.

# Session cookie (the browser is the usual source)
# HOEPLI_COOKIE=_bsw_session_v1_production=...; remember_user_token=...

# AUTH_TOKEN, normally re-read from the account on every run
# HOEPLI_TOKEN=

# Base64 AES key; normally captured from the running client
# HOEPLI_AES_KEY=

# Chrome executable (auto-detected when omitted)
# HOEPLI_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe

# DevTools port used for the session (default 9222)
# HOEPLI_PORT=9222

# Where the tool keeps its state (default ~/.hoepli-extract)
# HOEPLI_HOME=

# debug | info | warn | error | silent
# HOEPLI_LOG_LEVEL=info
